# Everything is optional. With nothing set, SubAudit runs in local mode (browser storage only).

# Postgres (Neon / Vercel Postgres). Enables cloud save + share links + reminders.
DATABASE_URL=

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
# Sign-in provider (need at least one, plus DATABASE_URL + AUTH_SECRET):
#  - Email magic link via Resend
AUTH_RESEND_KEY=
EMAIL_FROM="SubAudit <reminders@yourdomain.com>"
#  - GitHub OAuth (callback: https://<host>/api/auth/callback/github)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Email renewal reminders (7d / 1d) via Resend + Vercel Cron
RESEND_API_KEY=
CRON_SECRET=

# Optional AI extraction for pasted statements
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
